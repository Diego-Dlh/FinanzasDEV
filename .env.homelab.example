# =============================================================================
# Lumina Finance — Variables de entorno para homelab (Cloudflare Tunnel)
#   cp .env.homelab.example .env
# Luego reemplaza TODOS los valores CHANGE_ME. Nunca subas .env a git.
# Generar secretos:  openssl rand -base64 48 | tr -d '\n/+='
# =============================================================================

# Hace que `docker compose` y los scripts usen el stack del homelab
COMPOSE_FILE=docker-compose.homelab.yml

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=finanzasdev
POSTGRES_USER=lumina_user
# Solo letras y números (va dentro de la URL de conexión)
POSTGRES_PASSWORD=CHANGE_ME

# ─── JWT (mínimo 32 caracteres aleatorios) ────────────────────────────────────
JWT_SECRET=CHANGE_ME

# ─── Clave para /api/admin/setup y /api/seed/categorias ───────────────────────
SEED_KEY=CHANGE_ME

# ─── Administrador inicial (lo crea scripts/homelab-init.sh) ──────────────────
ADMIN_EMAIL=tu-correo@ejemplo.com
ADMIN_NAME=Administrador
# Obligatoria: no dejes que el código use su contraseña por defecto
ADMIN_PASSWORD=CHANGE_ME

# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Zero Trust → Networks → Tunnels → Create tunnel → (Docker) → copia el token
TUNNEL_TOKEN=CHANGE_ME
